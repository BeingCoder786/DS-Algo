fun isBST(root: TreeNode?): Boolean {
    return check(root, Long.MIN_VALUE, Long.MAX_VALUE)
}

fun check(node: TreeNode?, min: Long, max: Long): Boolean {

    if (node == null)
        return true

    if (node.value <= min || node.value >= max)
        return false

    return check(node.left, min, node.value.toLong()) &&
           check(node.right, node.value.toLong(), max)
}

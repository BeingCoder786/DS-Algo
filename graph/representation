       //adajacency
        var graph = mutableMapOf<Int,MutableList<Int>>()
    
        fun addEdge(u:Int,v:Int){
        
        if(graph.containsKey(u)){
            graph[u]!!.add(v)
        }
        else{
            graph[u]= mutableListOf(v)
        }
        
        
            if(graph.containsKey(v)){//unidrection
            graph[v]!!.add(u)
        }
        else{
            graph[v]= mutableListOf(u)
        }
        
    }
    
    

fun main() {

    // -------------------------
    // 1. Graph Representation (Adjacency List)
    // -------------------------
    val graph = mutableMapOf<Int, MutableList<Int>>()

    // Function to add edge (UNDIRECTED)
    fun addEdge(u: Int, v: Int) {

        if (graph.containsKey(u)) {
            graph[u]!!.add(v)
        } else {
            graph[u] = mutableListOf(v)
        }

        if (graph.containsKey(v)) {
            graph[v]!!.add(u)
        } else {
            graph[v] = mutableListOf(u)
        }
    }

    // -------------------------
    // 2. Create Graph
    // -------------------------
    addEdge(0, 1)
    addEdge(0, 2)
    addEdge(1, 3)
    addEdge(2, 3)

    // Print graph
    println("Graph:")
    for (node in graph.keys) {
        print("$node -> ")
        for (n in graph[node]!!) {
            print("$n ")
        }
        println()
    }

    // -------------------------
    // 3. BFS
    // -------------------------
    fun bfs(start: Int) {
        val visited = mutableSetOf<Int>()
        val queue: ArrayDeque<Int> = ArrayDeque()

        queue.add(start)
        visited.add(start)

        print("BFS: ")
        while (queue.isNotEmpty()) {
            val node = queue.removeFirst()
            print("$node ")

            for (neighbor in graph[node]!!) {
                if (!visited.contains(neighbor)) {
                    visited.add(neighbor)
                    queue.add(neighbor)
                }
            }
        }
        println()
    }

    // -------------------------
    // 4. DFS
    // -------------------------
    fun dfs(node: Int, visited: MutableSet<Int>) {
        visited.add(node)
        print("$node ")

        for (neighbor in graph[node]!!) {
            if (!visited.contains(neighbor)) {
                dfs(neighbor, visited)
            }
        }
    }

    // -------------------------
    // 5. Call BFS & DFS
    // -------------------------
    bfs(0)

    print("DFS: ")
    dfs(0, mutableSetOf())
}




